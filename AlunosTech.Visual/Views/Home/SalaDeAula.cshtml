@model AlunosTech.Visual.Models.Matricula

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Curso?.Titulo — Sala de Aula AVA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background-color: #ffffff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .ava-header { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); }
        .tile-ava { border-radius: 6px; padding: 30px 15px; text-align: center; color: white; cursor: pointer; transition: transform 0.15s ease; border: none; width: 100%; }
        .tile-ava:hover { transform: scale(1.02); filter: brightness(1.05); }
        .tile-grey { background-color: #c4c4c4; color: #fff; }
        .tile-cyan { background-color: #00bcd4; color: #fff; }
        .tile-cream { background-color: #f0e68c; color: #5c5c3d; }
        .tile-blue { background-color: #2196f3; color: #fff; }
    </style>
</head>
<body>

    <div class="ava-header text-white py-3 px-4 mb-4 shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <a asp-action="Index" class="text-info text-decoration-none small fw-bold">
                    <i class="bi bi-arrow-left me-1"></i>Voltar para Meus Cursos
                </a>
                <h4 class="fw-bold mb-0 mt-1">@Model.Curso?.Codigo: @Model.Curso?.Titulo</h4>
            </div>
            <div class="text-end">
                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Progresso: @Model.ProgressoPercentual%</span>
            </div>
        </div>
    </div>

    <div class="container pb-5" style="max-width: 900px;">

        <!-- Alerta de Conclusão / Prova Final -->
        @if (Model.ProgressoPercentual >= 100)
        {
            <div class="alert alert-success border-2 shadow-sm p-4 mb-4 text-center rounded-4">
                <h4 class="fw-bold text-success mb-2"><i class="bi bi-award-fill me-2"></i>Parabéns! Conteúdo Concluído 100%</h4>
                <p class="mb-3 text-secondary">Você concluiu todos os materiais obrigatórios desta disciplina. A Avaliação Final (Prova) está liberada.</p>
                <button class="btn btn-success btn-lg fw-bold px-5 rounded-pill shadow" onclick="alert('Simulação: Prova Final enviada com sucesso! Parabéns pela aprovação na disciplina da Alunos Tech.')">
                    <i class="bi bi-file-earmark-check-fill me-2"></i>Realizar Prova Final
                </button>
            </div>
        }

        <!-- Plano de Ensino (+15%) -->
        <div class="mb-5">
            <h5 class="text-info fw-bold border-bottom pb-2 mb-3"><i class="bi bi-journal-text me-2"></i>PLANO DE ENSINO</h5>
            <div class="row">
                <div class="col-md-6">
                    <form asp-action="ConcluirAtividade" method="post">
                        <input type="hidden" name="matriculaId" value="@Model.Id" />
                        <input type="hidden" name="incremento" value="15" />
                        <button type="submit" class="tile-ava tile-grey shadow-sm">
                            <i class="bi bi-file-earmark-text display-5 d-block mb-2"></i>
                            <span class="fw-bold text-uppercase small text-decoration-underline">Plano de Ensino (+15%)</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Unidade I -->
        <div>
            <h5 class="text-info fw-bold border-bottom pb-2 mb-4"><i class="bi bi-book-half me-2"></i>UNIDADE I — CONTEÚDO PROGRAMÁTICO</h5>

            <div class="row g-3">
                <!-- Livro Texto (+25%) -->
                <div class="col-md-6">
                    <form asp-action="ConcluirAtividade" method="post">
                        <input type="hidden" name="matriculaId" value="@Model.Id" />
                        <input type="hidden" name="incremento" value="25" />
                        <button type="submit" class="tile-ava tile-cyan shadow-sm">
                            <i class="bi bi-book display-5 d-block mb-2"></i>
                            <span class="fw-bold text-uppercase small text-decoration-underline">Livro-Texto (LT) (+25%)</span>
                        </button>
                    </form>
                </div>

                <!-- Slides de Aula (+20%) -->
                <div class="col-md-6">
                    <form asp-action="ConcluirAtividade" method="post">
                        <input type="hidden" name="matriculaId" value="@Model.Id" />
                        <input type="hidden" name="incremento" value="20" />
                        <button type="submit" class="tile-ava tile-cream shadow-sm">
                            <i class="bi bi-easel display-5 d-block mb-2"></i>
                            <span class="fw-bold text-uppercase small text-decoration-underline">Slides de Aula (+20%)</span>
                        </button>
                    </form>
                </div>

                <!-- Videoaulas 01 a 04 (+10% cada = 40%) -->
                @for (int i = 1; i <= 4; i++)
                {
                    <div class="col-md-6">
                        <form asp-action="ConcluirAtividade" method="post">
                            <input type="hidden" name="matriculaId" value="@Model.Id" />
                            <input type="hidden" name="incremento" value="10" />
                            <button type="submit" class="tile-ava tile-blue shadow-sm">
                                <i class="bi bi-play-btn display-5 d-block mb-2"></i>
                                <span class="fw-bold text-uppercase small">Videoaula 0@i (+10%)</span>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>