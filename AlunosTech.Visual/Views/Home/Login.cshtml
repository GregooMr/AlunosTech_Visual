@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alunos Tech AVA — Acesso ao Sistema</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
            body {
                background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card-login {
                border: none;
                border-radius: 16px;
                box-shadow: 0 15px 35px rgba(0,0,0,0.3);
            }

            .btn-tech {
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                border: none;
                color: white;
            }

                .btn-tech:hover {
                    background: linear-gradient(135deg, #162d56 0%, #204078 100%);
                    color: white;
                }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="text-center text-white mb-4">
            <h1 class="fw-bold"><i class="bi bi-mortarboard-fill text-info me-2"></i>ALUNOS TECH • AVA</h1>
            <p class="text-white-50">Ambiente Virtual de Aprendizagem Corporativo — Sistema Legado v1.0</p>
        </div>

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger text-center mx-auto col-lg-8 rounded-3 shadow-sm">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Erro"]
            </div>
        }

        <div class="row justify-content-center g-4">
            <!-- Card de Login -->
            <div class="col-lg-5">
                <div class="card card-login h-100">
                    <div class="card-body p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <h4 class="fw-bold text-primary mb-1"><i class="bi bi-box-arrow-in-right me-2"></i>Área do Aluno</h4>
                            <p class="text-muted small mb-4">Entre com suas credenciais acadêmicas cadastradas.</p>

                            <form asp-action="Entrar" method="post">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small text-secondary">E-MAIL INSTITUCIONAL</label>
                                    <input type="email" name="email" class="form-control form-control-lg fs-6" placeholder="carlos@alunostech.com" value="carlos@alunostech.com" required />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold small text-secondary">SENHA</label>
                                    <input type="password" name="senha" class="form-control form-control-lg fs-6" placeholder="••••••" value="123" required />
                                </div>
                                <button type="submit" class="w-100 btn btn-tech btn-lg fw-semibold rounded-3">
                                    Acessar AVA
                                </button>
                            </form>
                        </div>
                        <div class="mt-4 pt-3 border-top text-center">
                            <span class="badge bg-warning text-dark">Acesso Rápido: carlos@alunostech.com | Senha: 123</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card de Nova Matrícula -->
            <div class="col-lg-5">
                <div class="card card-login h-100">
                    <div class="card-body p-4 p-md-5">
                        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-person-plus-fill text-success me-2"></i>Nova Matrícula</h4>
                        <p class="text-muted small mb-4">Cadastre seu acesso e escolha sua primeira disciplina.</p>

                        <form asp-action="CadastrarEMatricular" method="post">
                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-secondary">NOME COMPLETO</label>
                                <input type="text" name="nome" class="form-control" placeholder="Ex: Ana Paula Oliveira" required />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-7">
                                    <label class="form-label fw-semibold small text-secondary">E-MAIL</label>
                                    <input type="email" name="email" class="form-control" placeholder="ana@email.com" required />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold small text-secondary">CRIAR SENHA</label>
                                    <input type="password" name="senha" class="form-control" placeholder="Senha" required />
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold small text-secondary">CURSO INICIAL</label>
                                <select name="cursoId" class="form-select" required>
                                    <option value="">Selecione a disciplina...</option>
                                    @foreach (var curso in ViewBag.Cursos)
                                    {
                                        <option value="@curso.Id">@curso.Codigo - @curso.Titulo</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="w-100 btn btn-success btn-lg fw-semibold rounded-3">
                                Realizar Matrícula e Entrar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>